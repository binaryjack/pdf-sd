<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\core-engine\target\release\libcore_engine.so" Condition="Exists('..\..\core-engine\target\release\libcore_engine.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\core-engine\target\release\core_engine.dll" Condition="Exists('..\..\core-engine\target\release\core_engine.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\core-engine\target\release\libcore_engine.dylib" Condition="Exists('..\..\core-engine\target\release\libcore_engine.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
